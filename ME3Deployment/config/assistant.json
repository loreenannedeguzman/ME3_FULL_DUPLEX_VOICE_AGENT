    {
      "id": "productivity",
      "module": "me3_productivity.server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "productivity_context",
        "list_tasks",
        "read_task",
        "list_events",
        "read_event",
        "list_notes",
        "read_note",
        "search_notes",
        "planning_context"
