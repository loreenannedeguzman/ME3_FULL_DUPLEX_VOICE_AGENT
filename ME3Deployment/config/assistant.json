{
  "version": 1,
  "runtime": {
    "max_session_seconds": 3600,
    "max_turns": 128,
    "tool_rounds": 24,
    "batch_calls": 3,
    "rpc_calls": 128
  },
  "servers": [
    {
      "id": "utilities",
      "module": "me3_assistant.utility_server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "calculate_expression",
        "get_current_time"
      ]
    },
    {
      "id": "shopping",
      "module": "task_mcp.server",
      "args": [],
      "identity": "me3",
      "role": "task",
      "read_tools": [
        "list_items"
      ]
    },
    {
      "id": "library",
      "module": "me3_assistant.library_server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "list_documents",
        "search_documents",
        "read_document"
      ]
    },
    {
      "id": "music",
      "module": "me3_assistant.music_server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "list_tracks",
        "get_playback_status",
        "search_tracks",
        "get_queue",
        "list_playlists",
        "read_playlist"
      ]
    },
    {
      "id": "reminders",
      "module": "me3_assistant.reminder_server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "list_reminders"
      ]
    },
    {
      "id": "research",
      "module": "me3_assistant.research_server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "read_wikipedia_article",
        "search_wikipedia",
        "search_web",
        "find_weather_locations",
        "read_current_weather",
        "list_news_sources",
        "read_news_source"
      ],
      "rpc_timeout_seconds": 30
    },
    {
      "id": "youtube",
      "module": "me3_assistant.youtube_server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "search_videos",
        "read_video_metadata",
        "get_player_status"
      ],
      "rpc_timeout_seconds": 20
    },
    {
      "id": "soundcloud",
      "module": "me3_stream.server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "search_music",
        "get_stream_status"
      ],
      "rpc_timeout_seconds": 30
    },
    {
      "id": "whatsapp",
      "module": "me3_whatsapp.server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "get_session_status",
        "get_recent_message_status",
        "search_contacts",
        "inspect_contact"
      ],
      "rpc_timeout_seconds": 30
    },
    {
      "id": "workspace",
      "module": "me3_assistant.workspace_server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "workspace_capabilities",
        "list_workspace_files",
        "read_workspace_file"
