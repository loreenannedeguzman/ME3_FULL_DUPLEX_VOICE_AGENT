    },
    {
      "id": "gcalendar",
      "module": "me3_google_calendar.server",
      "args": [],
      "identity": "me3",
      "role": "utility",
      "read_tools": [
        "google_calendar_context",
        "list_google_calendar_events",
        "read_google_calendar_event"
      ],
      "rpc_timeout_seconds": 30
    }
