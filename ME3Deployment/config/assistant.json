  "actions": [
    {
      "name": "propose_shopping_item",
      "server": "shopping",
      "adapter": "shopping_item"
    },
    {
      "name": "propose_music_control",
      "server": "music",
      "adapter": "music_control"
    },
    {
      "name": "propose_reminder",
      "server": "reminders",
      "adapter": "reminder_control"
    },
    {
      "name": "propose_youtube_control",
      "server": "youtube",
      "adapter": "youtube_control"
    },
    {
      "name": "propose_stream_control",
      "server": "soundcloud",
      "adapter": "soundcloud_control"
    },
    {
      "name": "propose_whatsapp_message",
      "server": "whatsapp",
      "adapter": "whatsapp_message"
    },
    {
      "name": "propose_whatsapp_window",
      "server": "whatsapp",
      "adapter": "whatsapp_window"
    },
    {
      "name": "propose_contact_message",
      "server": "whatsapp",
      "adapter": "whatsapp_contact_message"
    },
    {
      "name": "propose_whatsapp_call",
      "server": "calling",
      "adapter": "whatsapp_call"
    },
    {
      "name": "propose_productivity",
      "server": "productivity",
      "adapter": "productivity_control"
    },
    {
      "name": "propose_gmail_send",
      "server": "gmail",
      "adapter": "gmail_send"
    },
    {
      "name": "propose_gmail_read",
      "server": "gmail",
      "adapter": "gmail_read"
    },
    {
      "name": "propose_google_calendar",
