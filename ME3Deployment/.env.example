# Copy to .env locally. Never paste a real key into chat or commit .env.
GOOGLE_API_KEY=
# Set the exact Gemini Live model available to your account; no model is assumed.
GEMINI_MODEL=
GEMINI_VOICE=Aoede
# Set to 1 only after approving provider choice, audio transfer and API costs.
ALLOW_PROVIDER_AUDIO=0
MAX_SESSION_SECONDS=180
# Blank uses default devices. Run --list-devices for indices.
INPUT_DEVICE_INDEX=
OUTPUT_DEVICE_INDEX=

# Optional explicit local neural backend (install separately; no fallback).
# TTS_PROVIDER=piper
# PIPER_PYTHON=/home/pi/me3-duplex/.venv-piper/bin/python
# PIPER_MODEL=/home/pi/me3-duplex/models/piper/en_US-ljspeech-high.onnx
